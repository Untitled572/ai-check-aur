#!/bin/bash

CACHE_DIR="${HOME}/.cache/ai-check-aur"
CACHE_FILE="${CACHE_DIR}/cache"
LOG_FILE="${CACHE_DIR}/audit.log"
DEFAULT_TIMEOUT=60
DEFAULT_MODEL="opencode/deepseek-v4-flash-free"
DEFAULT_FAIL_ACTION="skip"

# Capture environment variables BEFORE config file loading
ORIG_ENABLED="${AI_CHECK_ENABLED:-}"
ORIG_MODEL="${AI_CHECK_MODEL:-}"
ORIG_TIMEOUT="${AI_CHECK_TIMEOUT:-}"
ORIG_FAIL_ACTION="${AI_CHECK_FAIL_ACTION:-}"

# [0] Load config
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CONFIG_DIRS=(
  "$SCRIPT_DIR"
  "${XDG_CONFIG_HOME:-$HOME/.config}/ai-check-aur"
)
CONFIG_FILE=""
for dir in "${CONFIG_DIRS[@]}"; do
  if [ -f "$dir/config.env" ]; then
    CONFIG_FILE="$dir/config.env"
    break
  fi
done

# Apply defaults
AI_CHECK_ENABLED=true
AI_CHECK_MODEL="$DEFAULT_MODEL"
AI_CHECK_TIMEOUT="$DEFAULT_TIMEOUT"
AI_CHECK_FAIL_ACTION="$DEFAULT_FAIL_ACTION"

if [ -n "$CONFIG_FILE" ]; then
  # shellcheck source=config.env
  source "$CONFIG_FILE"
fi

# Environment variables take precedence over config file
[ -n "$ORIG_ENABLED" ] && AI_CHECK_ENABLED="$ORIG_ENABLED"
[ -n "$ORIG_MODEL" ] && AI_CHECK_MODEL="$ORIG_MODEL"
[ -n "$ORIG_TIMEOUT" ] && AI_CHECK_TIMEOUT="$ORIG_TIMEOUT"
[ -n "$ORIG_FAIL_ACTION" ] && AI_CHECK_FAIL_ACTION="$ORIG_FAIL_ACTION"

mkdir -p "$CACHE_DIR"
ts=$(date '+%Y-%m-%d %H:%M:%S')

# [1] Enabled check
if [ "$AI_CHECK_ENABLED" != "true" ]; then
  exit 0
fi

# [2] Pre-checks
if ! command -v opencode &>/dev/null; then
  echo "[ai-check] WARNING: opencode not found, skip" >&2
  echo "[$ts] ${PKGBASE:-unknown} ${VERSION:-unknown} ERROR: opencode not found" >> "$LOG_FILE"
  exit 0
fi

if [ ! -f "PKGBUILD" ]; then
  echo "[ai-check] WARNING: PKGBUILD not found in $(pwd), skip" >&2
  echo "[$ts] ${PKGBASE:-unknown} ${VERSION:-unknown} ERROR: PKGBUILD not found" >> "$LOG_FILE"
  exit 0
fi

# [3] Cache check
if [ -n "$PKGBASE" ] && [ -n "$VERSION" ]; then
  if grep -qs "^${PKGBASE}:${VERSION}$" "$CACHE_FILE" 2>/dev/null; then
    echo "[ai-check] $PKGBASE: cached, skip"
    echo "[$ts] $PKGBASE $VERSION SKIP: cache hit" >> "$LOG_FILE"
    exit 0
  fi
fi

# [4] Read PKGBUILD
pkgbuild_content=$(cat PKGBUILD)

# [5] Build prompt
read -r -d '' prompt << PROMPT_EOF || true
你是一个 Arch Linux 安全审查专家。请严格审查以下 PKGBUILD 文件是否存在安全风险。

重要：以下情况不算风险，不要标记为 FAIL：
- source 中使用 example.com、localhost、0.0.0.0 等保留域名
- sha256sums 为 'SKIP'（这是正常用法）
- validpgpkeys 缺失（不是每个包都需要签名）
- 依赖声明缺失（这不是安全问题）
- 标准的 ./configure && make && make install 模式

以下情况才标记为 FAIL：
- source 中包含 pastebin、raw GitHub gist、hastebin 等临时粘贴服务 URL
- build/package 函数中执行 curl/wget 并 pipe 到 shell（curl | bash 模式）
- 下载并执行预编译二进制但没有 checksum 校验
- install 脚本中修改 /etc/passwd、/etc/shadow、authorized_keys、crontab 等敏感文件
- 向外部服务器发送数据（外联行为）
- 隐藏后门代码

如果安全，只输出一行：PASS
如果发现风险，只输出一行：FAIL: <具体风险描述>

PKGBUILD：
${pkgbuild_content}
PROMPT_EOF

echo "[ai-check] 正在审查 ${PKGBASE:-unknown} ..."

tmpf=$(mktemp /tmp/ai-check-aur.XXXXXX)
printf '%s\n' "$prompt" > "$tmpf"

set +e
result=$(timeout "$AI_CHECK_TIMEOUT" opencode run --model "$AI_CHECK_MODEL" "$(cat "$tmpf")" 2>/dev/null)
ec=$?
set -e
rm -f "$tmpf"

# [6] Parse result
result_lower=$(echo "$result" | tr '[:upper:]' '[:lower:]')

if [ $ec -ne 0 ]; then
  echo "[ai-check] WARNING: opencode call failed (exit $ec), skip" >&2
  echo "[$ts] ${PKGBASE:-unknown} ${VERSION:-unknown} ERROR: opencode exit $ec" >> "$LOG_FILE"
  exit 0
fi

if [ -z "$result" ]; then
  echo "[ai-check] WARNING: empty response, skip" >&2
  echo "[$ts] ${PKGBASE:-unknown} ${VERSION:-unknown} ERROR: empty response" >> "$LOG_FILE"
  exit 0
fi

if echo "$result_lower" | grep -q "^pass"; then
  echo "[ai-check] $PKGBASE: 通过审查"
  echo "${PKGBASE}:${VERSION}" >> "$CACHE_FILE" 2>/dev/null
  echo "[$ts] $PKGBASE $VERSION PASS" >> "$LOG_FILE"
  exit 0
fi

if echo "$result_lower" | grep -qE "^(fail|失败|风险)"; then
  case "$AI_CHECK_FAIL_ACTION" in
    block)
      echo "[ai-check] 发现安全风险: $PKGBASE" >&2
      echo "────────────────────────────────────────────" >&2
      echo "$result" >&2
      echo "────────────────────────────────────────────" >&2
      echo "[$ts] $PKGBASE $VERSION FAIL: $result" >> "$LOG_FILE"
      exit 1
      ;;
    skip)
      echo "[ai-check] 已跳过: $PKGBASE" >&2
      echo "[$ts] $PKGBASE $VERSION SKIP: fail_action=skip" >> "$LOG_FILE"
      exit 1
      ;;
    warn|*)
      echo "[ai-check] WARNING: $PKGBASE 存在风险，允许安装" >&2
      echo "$result" >&2
      echo "[$ts] $PKGBASE $VERSION WARN: $result" >> "$LOG_FILE"
      exit 0
      ;;
  esac
fi

echo "[ai-check] WARNING: 无法解析结果（${result:0:80}），放行" >&2
echo "[$ts] ${PKGBASE:-unknown} ${VERSION:-unknown} UNPARSABLE: $result" >> "$LOG_FILE"
exit 0
