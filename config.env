# AI 审查配置

# 是否启用审查（true/false）
# 设为 false 时直接放行所有包，不调用 AI
AI_CHECK_ENABLED=true

# 使用的模型（opencode 的 provider/model 格式）
# 小米官方 API 模型 ID: mimo-v2.6-flash
# 官方来源: https://mimo.mi.com/docs/en-US/updates/model
# xiaomi 为 opencode 中的小米提供商 ID，需要配置对应 API Key。
AI_CHECK_MODEL="xiaomi/mimo-v2.6-flash"

# 超时时间（秒）
AI_CHECK_TIMEOUT=60

# 审查失败后操作
# block = 显示风险详情，阻止安装（exit 1）
# skip  = 阻止该包（exit 1）；paru 是否继续取决于其 FailFast 设置
# warn  = 打印警告，允许安装（exit 0）
AI_CHECK_FAIL_ACTION=skip

# 审查出错（缺少依赖、API 失败、超时、空响应、无法解析）时操作
# block = 阻止未完成审查的包（exit 1，默认）
# warn  = 警告并允许安装（exit 0）
AI_CHECK_ERROR_ACTION=block
