# AI 审查配置

# 是否启用审查（true/false）
# 设为 false 时直接放行所有包，不调用 AI
AI_CHECK_ENABLED=true

# 使用的模型
# 免费模型:
#   opencode/deepseek-v4-flash-free   (DeepSeek V4 Flash 免费)
#   opencode/mimo-v2.5-free           (Xiaomi MiMo-V2.5 免费)
#   opencode/nemotron-3-ultra-free    (Nemotron 3 Ultra 免费)
#   opencode/north-mini-code-free     (North Mini Code 免费)
#   opencode/big-pickle               (Big Pickle)
# 付费模型:
#   deepseek/deepseek-v4-flash        (DeepSeek V4 Flash)
#   xiaomi/mimo-v2.5                  (Xiaomi MiMo-V2.5)
AI_CHECK_MODEL="opencode/deepseek-v4-flash-free"

# 超时时间（秒）
AI_CHECK_TIMEOUT=60

# 审查失败后操作
# block = 显示风险详情，阻止安装（exit 1）
# skip  = 仅跳过该包，继续下一个（exit 1）
# warn  = 打印警告，允许安装（exit 0）
AI_CHECK_FAIL_ACTION=skip
